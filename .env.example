# Copiá este archivo como .env.local y ajustá lo que necesites.
# Todos los valores tienen respaldo en src/config/, así que el proyecto arranca
# sin configurar nada.

# URL pública del sitio. Afecta metadatos, Open Graph y sitemap.
# En Vercel, poner acá el dominio real cuando exista.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo de acceso al catálogo:
#   anon   → sesión anónima antes de leer (funciona con las reglas actuales)
#   public → lectura sin token (activar tras abrir las reglas en la Fase 0)
CATALOG_ACCESS=anon

# Firebase. Solo hace falta tocarlo si se cambia de proyecto.
# OJO: la base de datos es NOMBRADA, no la "(default)".
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=gen-lang-client-0460782288
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=ai-studio-5c0f20d4-1ed2-4741-aa36-9644b15dbb81
